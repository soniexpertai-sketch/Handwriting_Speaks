---
import BaseLayout from '../layouts/BaseLayout.astro';

// What analysis surfaces. Split into term + detail so each can render as a
// card rather than a bullet — same wording as before, from Jyoti's own
// first-person bio (CONTENT_LIBRARY.md §3 "Analysis outputs").
const REVEALS = [
  { term: 'Personality traits', detail: 'including the ones you don’t show' },
  { term: 'Strengths', detail: 'you may not have recognised in yourself' },
  { term: 'Thinking patterns', detail: 'how you process and decide' },
  { term: 'Emotional responses', detail: 'and what sets them off' },
  { term: 'Fears', detail: 'and the defence mechanisms built around them' },
  { term: 'Area that needs improvement', detail: '' },
];

// "Key areas of Consultation" — transcribed verbatim from the approved
// reference poster (CONTENT_LIBRARY.md IMG-04). Local to this page rather
// than in consts.ts: this is Home-page editorial content, not shared config
// like SERVICES (which drives the Services page cards and their per-service
// WhatsApp messages).
// "Selecting the right match for your professional and personal
// association" was dropped from the source list (2026-07-28) — its length
// forced every card in the row to the height of its 3-line title. The
// remaining four fit one row evenly.
const KEY_AREAS = [
  'Know yourself',
  'Student & Teenagers development growth',
  'Recruitment & Employee Assessment',
  'Insight into your signature and correction',
];
---

<BaseLayout title="Home" path="/">
 <div class="home">
  <!-- Decorative 3D floating letters. Sits at page level, not inside the
       hero, so it spans every section — inside .hero it was boxed to that
       one section by `inset: 0` and clipped by its `overflow: hidden`.
       z-index 1 puts it above each section's own background fill (the
       pale-green and navy bands are opaque and would otherwise hide it)
       while every section's content sits at z-index 2, above the letters.
       Purely visual: aria-hidden and pointer-events:none. -->
  <div class="floating-letters" aria-hidden="true">
    <span class="fl fl-1">h</span>
    <span class="fl fl-2">s</span>
    <span class="fl fl-3">y</span>
    <span class="fl fl-4">o</span>
    <span class="fl fl-5">u</span>
    <span class="fl fl-6">a</span>
    <span class="fl fl-7">w</span>
    <span class="fl fl-8">n</span>
    <span class="fl fl-9">d</span>
    <span class="fl fl-10">r</span>
    <span class="fl fl-11">e</span>
    <span class="fl fl-12">g</span>
  </div>

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-heading">
    <!-- Single full-width text flow with the badge floated out of it, rather
         than a heading block stacked on a two-column row. Three reasons:
         every text block now shares one containing block, so their left
         edges are identical by construction; the copy is no longer boxed
         into a narrow column, so it runs the width of the page and wraps
         around the badge; and there is only one translucent card, so
         nothing can paint over the badge. -->
    <div class="container">
     <div class="hero-inner">
      <img
        class="badge-outer"
        src="/images/logo.jpg"
        alt=""
        width="340"
        height="340"
        loading="eager"
      />
      <p class="eyebrow">Handwriting &amp; Signature Analysis</p>
      <h1 id="hero-heading" class="hero-title">
        Discover Yourself Through the Power of Handwriting
      </h1>
      <p class="hero-subtitle">Unlock Your True Potential</p>
      <div class="hero-lead">
        <p>
          Every stroke of your handwriting tells a story — how you think, what
          you believe, and why you are the way you are.
        </p>
        <p>
          Handwriting and signature analysis reads that story. Then, through
          guided correction, it helps you rewrite the parts you'd like to
          change.
        </p>
      </div>
      <div class="hero-actions">
        <a href="/contact" class="btn btn--primary">Book a Consultation</a>
        <a href="/services" class="btn btn--outline">Explore services</a>
      </div>
     </div>
    </div>
  </section>

  <!-- WHAT YOUR HANDWRITING REVEALS -->
  <section class="reveal" aria-labelledby="reveal-heading">
    <div class="container">
      <header class="sec-head">
        <p class="eyebrow-script">Know the most unknowable</p>
        <h2 id="reveal-heading">What your handwriting reveals</h2>
        <p class="sec-lead">
          Human mind and behaviour has always been a mystery. Your handwriting
          makes it readable.
        </p>
      </header>

      <ul class="reveal-grid" role="list">
        {
          REVEALS.map((r) => (
            <li class="reveal-card">
              <h3>{r.term}</h3>
              {r.detail && <p>{r.detail}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- QUOTE BANNER -->
  <section class="quote-banner" aria-label="On the uniqueness of handwriting">
    <div class="container quote-inner">
      <blockquote>
        Your handwriting is unique, just like your fingerprints. No two persons
        in the world have the same handwriting — not even twins.
      </blockquote>
    </div>
  </section>

  <!-- WHERE HANDWRITING ANALYSIS HELPS -->
  <section class="helps" aria-labelledby="helps-heading">
    <div class="container">
      <header class="sec-head">
        <p class="eyebrow-script">Key areas of consultation</p>
        <h2 id="helps-heading">Where handwriting analysis helps</h2>
      </header>

      <div class="helps-grid">
        {
          KEY_AREAS.map((area) => (
            <article class="helps-card">
              <span class="helps-icon" aria-hidden="true">
                ✎
              </span>
              <h3>{area}</h3>
            </article>
          ))
        }
      </div>

      <p class="helps-note">
        Analysis is only the first step. With regular practice, simple
        handwriting exercises — Graphotherapy — help work on habits like
        procrastination, anger, mood swings, self-doubt, low confidence, lack
        of focus and indecisiveness.
      </p>
    </div>
  </section>

 </div>
</BaseLayout>

<style>
  /* Positioning context + horizontal clip for the page-wide letter layer.
     `overflow: hidden` lived on .hero before; it has to sit here now or
     letters near the edges would widen the page. */
  .home {
    position: relative;
    overflow: hidden;
  }
  /* Every section's content is lifted above the letter layer (z-index 1)
     so letters pass behind the words, never over them. */
  .home > section > .container {
    position: relative;
    z-index: 2;
  }

  .hero {
    position: relative;
    /* Bottom padding trimmed (was 72px) — with the logo pulled up into the
       heading band it no longer overhangs the text column, so the section
       can end sooner without the page feeling cramped. */
    padding-block: 52px 44px;
  }
  /* One card for the whole hero, replacing the separate heading/copy cards.
     Because it is the only translucent layer, nothing can paint over the
     floated badge inside it — the previous split had .hero-top (z-index 2)
     sitting above the badge's own grid (z-index 1), and a z-index on the
     badge couldn't escape that ancestor's stacking context, so the card
     washed over it. `flow-root` contains the float so the section still
     wraps its full height. */
  .hero-inner {
    position: relative;
    z-index: 2;
    display: flow-root;
    /* No inline padding — the container's own 48px gutter is the only
       horizontal inset, so hero text shares the exact left edge as every
       section below it. (The card has no visible border: its fill is the
       page's cream at 82% opacity, so text sitting flush to its edge reads
       normally.) */
    padding: 16px 0;
  }

  /* Decorative 3D floating letters — full-hero background layer. Each
     letter sits in its own perspective box so rotateX/rotateY reads as
     genuine 3D tilt (a single shared perspective on the parent would apply
     one vanishing point to every letter, flattening the effect for anything
     off-center). Low opacity + z-index:0 keeps it strictly behind the real
     copy/photo, never competing with them for attention or contrast. */
  .floating-letters {
    position: absolute;
    inset: 0;
    /* Above the section background fills, below section content. */
    z-index: 1;
    pointer-events: none;
  }
  .fl {
    position: absolute;
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    font-style: italic;
    perspective: 600px;
    transform-style: preserve-3d;
    animation: fl-float 6s ease-in-out infinite;
    will-change: transform;
  }
  /* Layered offset text-shadow (same hue, stepped darker) stands in for a
     true extruded 3D face — cheap, GPU-friendly, and reads as depth even at
     low opacity, unlike a single flat blur shadow.

     Each letter's static rotate/rotateX/rotateY tilt lives in the --tilt
     custom property rather than directly in `transform`, because the float
     keyframes below also set `transform` — and a CSS animation's transform
     value replaces the property outright each frame rather than merging
     with it. Routing the tilt through --tilt lets both the resting state
     and every animation frame reference the same value via var(--tilt), so
     the 3D tilt survives instead of flattening out mid-float. --dx gives
     each letter its own drift direction so the float reads as scattered
     rather than everything bobbing in lockstep.

     Positions are confined to the page margins either side of the 1100px
     content column. At a 1280px viewport that column spans x:130-1150, so
     the clear bands are x<130 and x>1150 — roughly 2% and 93% in
     percentage terms. Keeping every letter there means none can ever sit
     behind a line of text at any scroll position, which matters now that
     this layer runs the full page height rather than just the hero.
     Vertically they are spaced evenly from 3% to 91% so the drift is
     visible in every section. */
  .fl { --dx: 12px; }
  .fl-1  { top: 3%;  left: 2%;  font-size: clamp(46px, 5.0vw, 82px); color: rgba(31,111,92,0.42);  text-shadow: 2px 2px 0 rgba(31,111,92,0.22); --tilt: rotate(-10deg) rotateX(12deg) rotateY(-8deg);  --dx: 14px;  animation-delay: 0s;    transform: var(--tilt); }
  .fl-2  { top: 11%; left: 93%; font-size: clamp(44px, 4.8vw, 78px); color: rgba(224,102,74,0.4);  text-shadow: 2px 2px 0 rgba(224,102,74,0.2);  --tilt: rotate(6deg) rotateX(-10deg) rotateY(10deg);  --dx: -12px; animation-delay: 1.4s;  transform: var(--tilt); }
  .fl-3  { top: 19%; left: 2%;  font-size: clamp(44px, 4.8vw, 76px); color: rgba(247,173,74,0.48); text-shadow: 2px 2px 0 rgba(247,173,74,0.24); --tilt: rotate(-6deg) rotateX(10deg) rotateY(12deg);  --dx: -16px; animation-delay: 2.8s;  transform: var(--tilt); }
  .fl-4  { top: 27%; left: 93%; font-size: clamp(46px, 5.0vw, 80px); color: rgba(95,168,138,0.44); text-shadow: 2px 2px 0 rgba(95,168,138,0.22); --tilt: rotate(9deg) rotateX(-8deg) rotateY(-10deg); --dx: 10px;  animation-delay: 0.7s;  transform: var(--tilt); }
  .fl-5  { top: 36%; left: 2%;  font-size: clamp(44px, 4.8vw, 78px); color: rgba(193,74,114,0.4);  text-shadow: 2px 2px 0 rgba(193,74,114,0.2);  --tilt: rotate(-4deg) rotateX(8deg) rotateY(6deg);    --dx: 18px;  animation-delay: 2.1s;  transform: var(--tilt); }
  .fl-6  { top: 44%; left: 93%; font-size: clamp(26px, 3vw, 44px);   color: rgba(224,102,74,0.34); text-shadow: 2px 2px 0 rgba(224,102,74,0.16); --tilt: rotate(8deg) rotateX(-6deg) rotateY(-6deg);   --dx: -10px; animation-delay: 3.5s;  transform: var(--tilt); }
  .fl-7  { top: 52%; left: 2%;  font-size: clamp(44px, 4.8vw, 76px); color: rgba(247,173,74,0.4);  text-shadow: 2px 2px 0 rgba(247,173,74,0.2);  --tilt: rotate(-8deg) rotateX(9deg) rotateY(9deg);    --dx: 12px;  animation-delay: 1.9s;  transform: var(--tilt); }
  .fl-8  { top: 60%; left: 93%; font-size: clamp(26px, 3vw, 44px);   color: rgba(31,111,92,0.36);  text-shadow: 2px 2px 0 rgba(31,111,92,0.18);  --tilt: rotate(5deg) rotateX(-9deg) rotateY(-11deg);  --dx: -14px; animation-delay: 0.4s;  transform: var(--tilt); }
  .fl-9  { top: 68%; left: 2%;  font-size: clamp(44px, 4.8vw, 78px); color: rgba(95,168,138,0.4);  text-shadow: 2px 2px 0 rgba(95,168,138,0.2);  --tilt: rotate(-7deg) rotateX(7deg) rotateY(10deg);   --dx: 16px;  animation-delay: 3.1s;  transform: var(--tilt); }
  .fl-10 { top: 76%; left: 93%; font-size: clamp(26px, 3vw, 42px);   color: rgba(193,74,114,0.34); text-shadow: 2px 2px 0 rgba(193,74,114,0.17); --tilt: rotate(10deg) rotateX(-10deg) rotateY(8deg);  --dx: -18px; animation-delay: 2.5s;  transform: var(--tilt); }
  .fl-11 { top: 84%; left: 2%;  font-size: clamp(44px, 4.8vw, 76px); color: rgba(95,168,138,0.4);  text-shadow: 2px 2px 0 rgba(95,168,138,0.2);  --tilt: rotate(7deg) rotateX(-8deg) rotateY(11deg);   --dx: 14px;  animation-delay: 1.1s;  transform: var(--tilt); }
  .fl-12 { top: 91%; left: 93%; font-size: clamp(26px, 3vw, 44px);   color: rgba(247,173,74,0.4);  text-shadow: 2px 2px 0 rgba(247,173,74,0.2);  --tilt: rotate(-9deg) rotateX(8deg) rotateY(-10deg); --dx: -16px; animation-delay: 2.9s;  transform: var(--tilt); }

  @keyframes fl-float {
    0%,
    100% {
      transform: translate(0, 0) var(--tilt);
    }
    50% {
      transform: translate(var(--dx, 12px), -30px) var(--tilt);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fl {
      animation: none;
    }
  }

  /* Hidden entirely below 640px. The gutter drops to 20px there, which is
     narrower than the letters themselves — there is no margin left for
     them to occupy without sitting behind the copy. */
  @media (max-width: 640px) {
    .floating-letters {
      display: none;
    }
  }

  /* Copy column */
  .eyebrow {
    display: inline-block;
    padding: 6px 16px;
    border-radius: var(--r-pill);
    background: var(--section-green-alt);
    color: var(--green);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 22px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    /* Longer heading than the original 5-word line this size/line-height
       was tuned for, so it wraps to 2-3 lines now — loosened line-height
       from 1.02 to 1.1 so wrapped lines don't crowd each other. */
    font-size: clamp(44px, 7vw, 68px);
    line-height: 1.1;
    color: var(--ink-strong);
    margin-bottom: 12px;
  }
  /* The three coral Caveat lines on this page ("Unlock Your True
     Potential", "Know the most unknowable", "Key areas of consultation")
     are one type role, set at one fixed size so they can't drift apart. */
  .hero-subtitle {
    font-size: 32px;
  }
  .hero-subtitle {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--coral);
    margin-bottom: 18px;
  }
  /* Uncapped — the copy now runs the full container width and wraps around
     the floated badge, instead of being held to a 640px column inside a
     1265px container (which is what left it sitting in a narrow strip). */
  .hero-lead {
    margin-bottom: 0;
  }
  .hero-lead p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .hero-lead p + p {
    margin-top: 14px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 26px;
  }

  /* logo.jpg (960x960, replaced the earlier logo.svg 2026-07-23 — same
     design, raster now) is a square canvas filled edge-to-edge with the
     brand green and its own circular white disc + wordmark + tagline drawn
     inside — clipping the whole image to a circle here reproduces the same
     badge look that used to be hand-built from nested divs, using the real
     logo asset.

     Floated rather than placed in its own grid column so the text flows
     around it and still uses the full page width. shape-outside makes that
     wrap follow the circle instead of its square box, so lines tuck into
     the curve rather than stopping at a straight invisible edge. */
  .badge-outer {
    float: right;
    shape-outside: circle(50%);
    shape-margin: 24px;
    margin: 0 0 16px 40px;
    width: 300px;
    /* height: auto (not a fixed 340px) — with a fixed height, max-width:80vw
       could shrink the rendered width on narrow screens while height stayed
       locked at 340px, distorting the circle into an oval (confirmed:
       300x340 at a 375px viewport). aspect-ratio:1 + height:auto lets height
       always follow whatever width actually renders. */
    height: auto;
    max-width: 80vw;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow-hero);
  }
  /* --- Responsive ----------------------------------------------------- */
  @media (max-width: 860px) {
    .hero {
      padding-block: 56px 64px;
    }
    /* Un-float below 860px: there isn't enough width for text to wrap
       beside a 300px circle without the lines becoming too short to read,
       so the badge becomes a centred block above the copy instead. */
    .badge-outer {
      float: none;
      shape-outside: none;
      margin: 0 auto 28px;
    }
  }

  /* =====================================================================
     Shared section furniture — used by every section below the hero.
     ===================================================================== */
  .sec-head {
    margin-bottom: 32px;
    max-width: 720px;
  }
  .sec-head h2 {
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 800;
    line-height: 1.2;
    color: var(--ink-strong);
  }
  .sec-lead {
    margin-top: 14px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-muted);
  }
  /* Caveat script eyebrow — the same treatment the About page uses above
     "Meet your analyst", per DESIGN_TOKENS' "Script eyebrow" type token. */

  /* --- What your handwriting reveals ----------------------------------- */
  .reveal {
    background: var(--section-green);
    padding-block: 64px;
  }
  /* Cards, not bullets. Six plain text bullets in two ragged columns was
     the flattest block on the page; giving each its own surface and a
     numeral turns the same copy into something with structure and weight,
     and reuses the card pattern already used by the section below. */
  .reveal-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .reveal-card {
    position: relative;
    background: var(--white);
    border-radius: var(--r-card);
    padding: 24px 22px 22px;
    box-shadow: var(--shadow-card);
  }
  .reveal-card h3 {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink-strong);
  }
  .reveal-card p {
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* --- Quote banner ----------------------------------------------------- */
  .quote-banner {
    background: var(--banner-navy);
    padding-block: 56px;
  }
  /* The 800px cap that used to live here was what broke this quote onto
     four lines; at the wide container it sets in two. */
  .quote-banner blockquote {
    margin: 0;
    /* Left-aligned to share the x=80 edge every other block on the page
       now uses — it was centred, which read as a different indent. */
    text-align: left;
    /* 28px, not 30 — at the 1100px container this quote sets to 1980px on
       one line against 2008px of two-line space. That 28px of slack is
       less than a single word, so it broke to three lines; 28px leaves
       ~160px and lands it on two. */
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 800;
    line-height: 1.4;
    color: var(--white);
  }

  /* --- Where handwriting analysis helps -------------------------------- */
  .helps {
    padding-block: 64px;
  }
  /* Fixed 4 columns rather than auto-fit: with exactly four cards this
     puts them on one row at the 1100px container, and auto-fit's 240px
     minimum would only have fitted three, stranding the fourth. */
  .helps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .helps-card {
    background: var(--white);
    border-radius: var(--r-card);
    /* Tightened from 30px/26px — cards are narrower in a 4-up row, so the
       old padding left the copy squeezed against a lot of empty card. */
    padding: 20px 18px;
    box-shadow: var(--shadow-card);
  }
  .helps-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--green-mid);
    color: var(--white);
    font-size: 17px;
    margin-bottom: 10px;
  }
  .helps-card h3 {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink-strong);
  }
  .helps-note {
    margin-top: 24px;
    max-width: 760px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* --- Responsive: sections below the hero ------------------------------ */
  @media (max-width: 980px) {
    .reveal-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    /* 4-up → 2-up: below this the cards are too narrow for their titles,
       which are 2-4 words each. */
    .helps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .sec-head {
      margin-bottom: 28px;
    }
  }
  @media (max-width: 560px) {
    .reveal-grid,
    .helps-grid {
      grid-template-columns: 1fr;
    }
    .quote-banner {
      padding-block: 40px;
    }
  }

</style>
