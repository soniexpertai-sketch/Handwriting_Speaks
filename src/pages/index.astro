---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../consts';
---

<BaseLayout title="Home" path="/">
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-heading">
    <!-- Decorative 3D floating letters, behind all hero content. Purely
         visual — aria-hidden, pointer-events:none, and low-opacity so it
         never competes with the real copy/photo in front of it. -->
    <div class="floating-letters" aria-hidden="true">
      <span class="fl fl-1">h</span>
      <span class="fl fl-2">s</span>
      <span class="fl fl-3">y</span>
      <span class="fl fl-4">o</span>
      <span class="fl fl-5">u</span>
      <span class="fl fl-6">a</span>
      <span class="fl fl-7">w</span>
      <span class="fl fl-8">n</span>
      <span class="fl fl-9">d</span>
      <span class="fl fl-10">r</span>
      <span class="fl fl-11">e</span>
      <span class="fl fl-12">g</span>
    </div>

    <div class="container container--wide hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Handwriting &amp; Signature Analysis</p>
        <h1 id="hero-heading" class="hero-title">
          Discover Yourself Through the Power of Handwriting
        </h1>
        <p class="hero-subtitle">Unlock Your True Potential</p>
        <div class="hero-lead">
          <p>
            {CONTACT.analyst} is a Certified Handwriting &amp; Signature
            Analyst and Graphotherapist who helps students, professionals,
            entrepreneurs, homemakers, and individuals gain deeper
            self-awareness through handwriting and signature analysis.
          </p>
          <p>
            With over five years of experience, she empowers people to
            understand their strengths, overcome limiting patterns, and build
            confidence through personalised analysis, signature correction,
            and Graphotherapy. Her mission is to help individuals unlock
            their true potential and create positive, lasting transformation
            in their personal and professional lives.
          </p>
        </div>
        <div class="hero-actions">
          <a href="/contact" class="btn btn--primary">Book a Consultation</a>
          <a
            href={CONTACT.instagramUrl}
            target="_blank"
            rel="noopener"
            class="btn btn--outline"
          >
            Follow {CONTACT.instagramHandle}
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <img
          class="badge-outer"
          src="/images/logo.jpg"
          alt=""
          width="340"
          height="340"
          loading="eager"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 90px 100px;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }

  /* Brighter floating letters (below) need the real copy to visibly sit
     "in front" of them rather than just technically stack above via
     z-index — a soft solid-ish card behind the text gives it its own
     readable surface instead of the letters showing through the bare
     page background right behind the words. */
  .hero-copy {
    position: relative;
    z-index: 2;
    background: rgba(250, 246, 240, 0.82);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    border-radius: var(--r-lg);
    padding: 28px 32px;
  }

  /* Decorative 3D floating letters — full-hero background layer. Each
     letter sits in its own perspective box so rotateX/rotateY reads as
     genuine 3D tilt (a single shared perspective on the parent would apply
     one vanishing point to every letter, flattening the effect for anything
     off-center). Low opacity + z-index:0 keeps it strictly behind the real
     copy/photo, never competing with them for attention or contrast. */
  .floating-letters {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .fl {
    position: absolute;
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    font-style: italic;
    perspective: 600px;
    transform-style: preserve-3d;
    animation: fl-float 6s ease-in-out infinite;
    will-change: transform;
  }
  /* Layered offset text-shadow (same hue, stepped darker) stands in for a
     true extruded 3D face — cheap, GPU-friendly, and reads as depth even at
     low opacity, unlike a single flat blur shadow.

     Each letter's static rotate/rotateX/rotateY tilt lives in the --tilt
     custom property rather than directly in `transform`, because the float
     keyframes below also set `transform` — and a CSS animation's transform
     value replaces the property outright each frame rather than merging
     with it. Routing the tilt through --tilt lets both the resting state
     and every animation frame reference the same value via var(--tilt), so
     the 3D tilt survives instead of flattening out mid-float. --dx gives
     each letter its own drift direction so the float reads as scattered
     rather than everything bobbing in lockstep.

     Positions are deliberately confined to three bands that stay clear of
     the two opaque foreground layers on top of this one (the translucent
     .hero-copy card and the circular photo badge): the top margin (before
     .hero-grid's content starts), the bottom margin (after it ends), and
     the far right edge (outside the photo's centered width within its
     column). A letter placed mid-column, like the original "u" at
     top:40%/left:46%, renders directly behind the card and is effectively
     invisible despite being technically in the DOM. */
  .fl-1 {
    top: 0%;
    left: 4%;
    /* Capped at 64px (was 108px) — the top band only has ~90px of clearance
       before .hero-copy's fixed padding-block-start begins (confirmed via
       getBoundingClientRect: card top sits at a stable 90px from the
       section top on desktop, regardless of viewport width). A box taller
       than that clearance dips its lower third behind the card exactly
       like the original "u" did, just partially instead of fully. */
    font-size: clamp(40px, 5vw, 64px);
    color: rgba(31, 111, 92, 0.42); /* --green */
    text-shadow: 2px 2px 0 rgba(31, 111, 92, 0.22), 4px 4px 0 rgba(31, 111, 92, 0.12);
    --tilt: rotate(-10deg) rotateX(12deg) rotateY(-8deg);
    --dx: 14px;
    transform: var(--tilt);
    animation-delay: 0s;
  }
  .fl-2 {
    top: 0.5%;
    left: 40%;
    font-size: clamp(32px, 4vw, 52px);
    color: rgba(224, 102, 74, 0.4); /* --coral */
    text-shadow: 2px 2px 0 rgba(224, 102, 74, 0.2);
    --tilt: rotate(6deg) rotateX(-10deg) rotateY(10deg);
    --dx: -12px;
    transform: var(--tilt);
    animation-delay: 1.4s;
  }
  .fl-3 {
    top: 0.5%;
    left: 78%;
    font-size: clamp(36px, 4.5vw, 60px);
    color: rgba(247, 173, 74, 0.48); /* --amber */
    text-shadow: 2px 2px 0 rgba(247, 173, 74, 0.24);
    --tilt: rotate(-6deg) rotateX(10deg) rotateY(12deg);
    --dx: -16px;
    transform: var(--tilt);
    animation-delay: 2.8s;
  }
  .fl-4 {
    top: 95%;
    left: 8%;
    font-size: clamp(40px, 5.5vw, 76px);
    color: rgba(95, 168, 138, 0.44); /* --green-mid */
    text-shadow: 2px 2px 0 rgba(95, 168, 138, 0.22);
    --tilt: rotate(9deg) rotateX(-8deg) rotateY(-10deg);
    --dx: 10px;
    transform: var(--tilt);
    animation-delay: 0.7s;
  }
  .fl-5 {
    top: 96%;
    left: 48%;
    font-size: clamp(44px, 6vw, 84px);
    color: rgba(193, 74, 114, 0.4); /* --magenta */
    text-shadow: 2px 2px 0 rgba(193, 74, 114, 0.2);
    --tilt: rotate(-4deg) rotateX(8deg) rotateY(6deg);
    --dx: 18px;
    transform: var(--tilt);
    animation-delay: 2.1s;
  }
  .fl-6 {
    top: 94%;
    left: 82%;
    font-size: clamp(32px, 4.5vw, 60px);
    color: rgba(224, 102, 74, 0.34);
    text-shadow: 2px 2px 0 rgba(224, 102, 74, 0.16);
    --tilt: rotate(8deg) rotateX(-6deg) rotateY(-6deg);
    --dx: -10px;
    transform: var(--tilt);
    animation-delay: 3.5s;
  }
  .fl-7 {
    top: 38%;
    left: 95%;
    font-size: clamp(32px, 4.5vw, 60px);
    color: rgba(247, 173, 74, 0.4);
    text-shadow: 2px 2px 0 rgba(247, 173, 74, 0.2);
    --tilt: rotate(-8deg) rotateX(9deg) rotateY(9deg);
    --dx: 12px;
    transform: var(--tilt);
    animation-delay: 1.9s;
  }
  .fl-8 {
    top: 14%;
    left: 96%;
    font-size: clamp(28px, 4vw, 52px);
    color: rgba(31, 111, 92, 0.36);
    text-shadow: 2px 2px 0 rgba(31, 111, 92, 0.18);
    --tilt: rotate(5deg) rotateX(-9deg) rotateY(-11deg);
    --dx: -14px;
    transform: var(--tilt);
    animation-delay: 0.4s;
  }
  .fl-9 {
    top: 62%;
    left: 97%;
    font-size: clamp(28px, 4vw, 52px);
    color: rgba(95, 168, 138, 0.4);
    text-shadow: 2px 2px 0 rgba(95, 168, 138, 0.2);
    --tilt: rotate(-7deg) rotateX(7deg) rotateY(10deg);
    --dx: 16px;
    transform: var(--tilt);
    animation-delay: 3.1s;
  }
  .fl-10 {
    top: 0.5%;
    left: 60%;
    font-size: clamp(28px, 3.6vw, 48px);
    color: rgba(193, 74, 114, 0.34);
    text-shadow: 2px 2px 0 rgba(193, 74, 114, 0.17);
    --tilt: rotate(10deg) rotateX(-10deg) rotateY(8deg);
    --dx: -18px;
    transform: var(--tilt);
    animation-delay: 2.5s;
  }
  /* Left edge — mirrors the fl-7/8/9 right-edge trick: pinned just inside
     the section's own edge (outside .hero-copy's horizontal span, which
     starts at the container gutter), clear at any vertical position since
     nothing else renders out here. Fills the previously-empty left side. */
  .fl-11 {
    top: 32%;
    left: 0.5%;
    font-size: clamp(28px, 4vw, 52px);
    color: rgba(95, 168, 138, 0.4);
    text-shadow: 2px 2px 0 rgba(95, 168, 138, 0.2);
    --tilt: rotate(7deg) rotateX(-8deg) rotateY(11deg);
    --dx: 14px;
    transform: var(--tilt);
    animation-delay: 1.1s;
  }
  .fl-12 {
    top: 70%;
    left: 1%;
    font-size: clamp(28px, 4vw, 52px);
    color: rgba(247, 173, 74, 0.4);
    text-shadow: 2px 2px 0 rgba(247, 173, 74, 0.2);
    --tilt: rotate(-9deg) rotateX(8deg) rotateY(-10deg);
    --dx: -16px;
    transform: var(--tilt);
    animation-delay: 2.9s;
  }

  @keyframes fl-float {
    0%,
    100% {
      transform: translate(0, 0) var(--tilt);
    }
    50% {
      transform: translate(var(--dx, 12px), -30px) var(--tilt);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fl {
      animation: none;
    }
  }

  /* Fewer, smaller, quieter letters on narrow screens — the full set at
     full size would overpower the stacked single-column layout and fight
     with the copy for attention once there's no side-by-side space. */
  @media (max-width: 640px) {
    .fl-4,
    .fl-5,
    .fl-6,
    .fl-7,
    .fl-8,
    .fl-9,
    .fl-10,
    .fl-11,
    .fl-12 {
      display: none;
    }
  }

  /* Copy column */
  .eyebrow {
    display: inline-block;
    padding: 6px 16px;
    border-radius: var(--r-pill);
    background: var(--section-green-alt);
    color: var(--green);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 22px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    /* Longer heading than the original 5-word line this size/line-height
       was tuned for, so it wraps to 2-3 lines now — loosened line-height
       from 1.02 to 1.1 so wrapped lines don't crowd each other. */
    font-size: clamp(44px, 7vw, 68px);
    line-height: 1.1;
    color: var(--ink-strong);
    margin-bottom: 12px;
  }
  .hero-subtitle {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 3vw, 30px);
    color: var(--coral);
    margin-bottom: 22px;
  }
  /* Now a container of two <p> — was a single <p> before this copy grew
     to two paragraphs, so it needs its own inter-paragraph spacing. */
  .hero-lead {
    max-width: 520px;
    margin-bottom: 34px;
  }
  .hero-lead p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .hero-lead p + p {
    margin-top: 16px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* Visual column — round brand badge + floating accents */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  /* logo.jpg (960x960, replaced the earlier logo.svg 2026-07-23 — same
     design, raster now) is a square canvas filled edge-to-edge with the
     brand green and its own circular white disc + wordmark + tagline drawn
     inside — clipping the whole image to a circle here reproduces the same
     badge look that used to be hand-built from nested divs, using the real
     logo asset. */
  .badge-outer {
    display: block;
    width: 340px;
    /* height: auto (not a fixed 340px) — with a fixed height, max-width:80vw
       could shrink the rendered width on narrow screens while height stayed
       locked at 340px, distorting the circle into an oval (confirmed:
       300x340 at a 375px viewport). aspect-ratio:1 + height:auto lets height
       always follow whatever width actually renders. */
    height: auto;
    max-width: 80vw;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow-hero);
  }
  /* --- Responsive ----------------------------------------------------- */
  @media (max-width: 860px) {
    .hero {
      padding-block: 56px 72px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero-visual {
      order: -1;
    }
    .hero-lead {
      max-width: none;
    }
  }
  @media (max-width: 400px) {
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
