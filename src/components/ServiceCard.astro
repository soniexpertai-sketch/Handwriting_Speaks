---
// One service = one outlined card: icon, title, description. Icon reuses the
// same 46px sage-circle + ✎ glyph pattern already established in
// DESIGN_TOKENS' "Elevated card" component (Home page consult-area cards) —
// a plain-text Unicode glyph, not an icon font, so it can never render as a
// missing-glyph "tofu" box.
//
// The whole card links to the Contact page's consultation form with this
// service pre-selected in the dropdown (ConsultationForm.astro reads the
// ?service= query param on load), rather than opening WhatsApp directly —
// the form still ends in a WhatsApp message once submitted, so the site
// stays WhatsApp-only end to end, just routed through the structured form.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const href = `/contact?service=${encodeURIComponent(title)}#consult-form`;
---

<a
  class="service-card"
  href={href}
  aria-label={`${title} — book a consultation`}
>
  <span class="service-icon" aria-hidden="true">✎</span>
  <span class="service-title">{title}</span>
  <span class="service-desc">{description}</span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 2px solid var(--hairline);
    border-radius: var(--r-card);
    padding: 30px 26px;
    background: transparent;
    color: var(--ink-strong);
    transition: border-color 0.2s ease, transform 0.15s ease,
      box-shadow 0.2s ease;
  }
  .service-card:hover {
    border-color: var(--green-mid);
    color: var(--ink-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .service-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--green-mid);
    color: var(--white);
    display: grid;
    place-items: center;
    font-size: 20px;
    margin-bottom: 16px;
    flex-shrink: 0;
  }
  .service-title {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.35;
    margin-bottom: 12px;
  }
  .service-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-meta);
  }
</style>
