---
// One real client review. Semantic figure/blockquote/figcaption so screen
// readers get: rating → review text → who said it, in logical order.
import type { Testimonial } from '../data/testimonials';

interface Props extends Testimonial {
  /** Hidden by the tab filter when this card's service isn't active. */
  hidden?: boolean;
}
const {
  name,
  city,
  service,
  serviceLabel,
  rating,
  text,
  source,
  hidden = false,
} = Astro.props;

const initial = name.charAt(0).toUpperCase();
const displayName = city ? `${name}, ${city}` : name;
---

<figure class="tcard" data-service={service} hidden={hidden}>
  <blockquote class="tcard-quote">
    <span class="tcard-mark" aria-hidden="true">&ldquo;</span>

    {
      rating != null && (
        <div
          class="tcard-stars"
          role="img"
          aria-label={`Rated ${rating} out of 5 stars`}
        >
          {Array.from({ length: 5 }).map((_, i) => (
            <svg
              class:list={['star', { 'star--on': i < rating }]}
              viewBox="0 0 20 20"
              width="18"
              height="18"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.9l-5.2 2.73.99-5.79L1.58 7.62l5.82-.85L10 1.5z" />
            </svg>
          ))}
        </div>
      )
    }

    <p class="tcard-text">{text}</p>
  </blockquote>

  <figcaption class="tcard-foot">
    <span class="tcard-avatar" aria-hidden="true">{initial}</span>
    <span class="tcard-meta">
      <span class="tcard-name">{displayName}</span>
      <span class="tcard-service">{serviceLabel}</span>
      <span class="tcard-source">{source}</span>
    </span>
  </figcaption>
</figure>

<style>
  .tcard {
    break-inside: avoid;
    margin: 0 0 24px;
    background: var(--section-green);
    border-radius: var(--r-card);
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  /* Must beat `.tcard { display: flex }` so the tab filter actually hides. */
  .tcard[hidden] {
    display: none;
  }
  .tcard-quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .tcard-mark {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 0.6;
    color: var(--green-mid);
    height: 26px;
  }
  .tcard-stars {
    display: inline-flex;
    gap: 3px;
  }
  .star {
    fill: var(--hairline);
  }
  .star--on {
    fill: var(--amber);
  }
  .tcard-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
  }

  .tcard-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 4px;
  }
  .tcard-avatar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--green-mid);
    color: var(--white);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 16px;
  }
  .tcard-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .tcard-name {
    font-weight: 700;
    font-size: 15px;
    color: var(--ink-strong);
  }
  .tcard-service {
    font-size: 13px;
    font-weight: 600;
    color: var(--green);
  }
  .tcard-source {
    font-size: 12px;
    color: var(--text-meta);
  }
</style>
